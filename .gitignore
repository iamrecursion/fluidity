# Build output. `main.js` is the esbuild bundle, produced by `make build`; the
# release workflow attaches it to the GitHub release. The leading slashes anchor
# these to the repository root.
/main.js
/main.js.map

# npm
/node_modules/
npm-debug.log*

# Nix build results
/result
/result-*

# Obsidian plugin data, present when the repository is symlinked into a vault
# for testing.
/data.json

# The local development runbook: session state and working notes, not user
# documentation.
/PLAN.md

# Editors and operating systems
.DS_Store
*.swp
/.idea/
/.vscode/
